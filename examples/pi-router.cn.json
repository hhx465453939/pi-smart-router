{
  "enabled": true,
  "defaultModel": "volces/deepseek-v4-flash[1m]",
  "routingLevel": "turn",
  "cooldownMs": 60000,
  "failure": {
    "cooldownOnStatus": [429, 500, 502, 503, 504],
    "cooldownOnToolErrorPatterns": [
      "rate.?limit",
      "context.?length",
      "overloaded",
      "too.?many.?requests",
      "service.?unavailable",
      "timeout",
      "429",
      "503"
    ]
  },
  "cache": {
    "enabled": true,
    "preferCache": true,
    "minHitChars": 1024,
    "sticky": true,
    "stickyTtlMs": 300000
  },
  "learn": {
    "enabled": true,
    "windowSize": 50,
    "minSamples": 3,
    "successWeight": 1.0,
    "failureWeight": -2.0,
    "cacheWeight": 0.0005,
    "costWeight": -0.0001
  },
  "churn": {
    "enabled": true,
    "maxChurnTokens": 8000
  },
  "difficulty": {
    "enabled": true,
    "lowThreshold": 40,
    "highThreshold": 120
  },
  "selfLearn": {
    "enabled": true,
    "minSamples": 3,
    "decay": 0.9,
    "successWeight": 1.0,
    "failureWeight": -2.0,
    "costWeight": -0.0001
  },
  "probe": {
    "enabled": true,
    "timeoutMs": 300000,
    "probeOnStart": true,
    "excludeUnavailable": true
  },
  "taskTypeRules": {
    "code": ["implement", "fix", "bug", "refactor", "function", "api", "test", "type", "error", "compile", "stack", "trace", "deploy", "migrate"],
    "document": ["document", "readme", "doc", "explain", "summarize", "write", "draft", "proposal", "report"],
    "research": ["research", "investigate", "analyze", "compare", "find", "search", "explore", "audit", "survey"]
  },
  "rules": [
    {
      "id": "frontend-task",
      "name": "前端任务用 k3-256k",
      "priority": 110,
      "when": { "prompt": { "contains": "react" } },
      "model": "kimi-coding/k3-256k",
      "cacheAware": true
    },
    {
      "id": "frontend-task-vue",
      "name": "前端任务用 k3-256k",
      "priority": 109,
      "when": { "prompt": { "contains": "vue" } },
      "model": "kimi-coding/k3-256k",
      "cacheAware": true
    },
    {
      "id": "frontend-task-cn",
      "name": "前端任务用 k3-256k",
      "priority": 108,
      "when": { "prompt": { "contains": "前端" } },
      "model": "kimi-coding/k3-256k",
      "cacheAware": true
    },
    {
      "id": "ops-debug",
      "name": "运维/debug 推 codex",
      "priority": 105,
      "when": { "taskType": "code", "prompt": { "contains": "debug" } },
      "model": "openai-codex/gpt-5.3-codex-spark"
    },
    {
      "id": "complex-backend",
      "name": "复杂后端逻辑用 glm-5.3",
      "priority": 100,
      "when": { "taskType": "code" },
      "model": "zai-coding-cn/glm-5.3",
      "cacheAware": true
    },
    {
      "id": "image-task",
      "name": "多模态任务",
      "priority": 95,
      "when": { "hasImage": true },
      "model": "opencode-go/deepseek-v4-flash-vision-exp"
    },
    {
      "id": "long-context",
      "name": "长上下文用大窗口",
      "priority": 90,
      "when": { "contextTokens": { "gt": 100000 } },
      "model": "kimi-coding/k3-256k"
    }
  ],
  "fallback": {
    "mode": "model-chain",
    "models": [
      "volces/deepseek-v4-flash[1m]",
      "zai-coding-cn/glm-5.3",
      "opencode-go/deepseek-v4-pro",
      "zai-coding-cn/glm-5.3-flash"
    ]
  },
  "explicitModelPrefix": "@model:",
  "verbose": false
}
